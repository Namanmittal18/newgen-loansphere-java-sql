# ============================================================================
# LoanSphere Environment Variables Configuration Example
# Copy this file to .env or export the variables in your execution environment
# ============================================================================

# Database Connection (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/newgen_loan_origination?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_secure_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Configurable Business Date (Format: YYYY-MM-DD)
# Set to simulate past or future business dates for boundary testing (e.g., 2026-11-23)
BUSINESS_DATE=2026-11-23

# CSV Export Directory
CSV_EXPORT_DIR=./exports
